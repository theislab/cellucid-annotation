{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cellucid.com/contracts/community-annotation/config-v1.schema.json",
  "title": "Cellucid Community Annotation Repository Configuration",
  "description": "Whitespace is the class [\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff], the union of ECMAScript \\s and Python str.isspace(); text is exact when its first and last characters are outside it. No text or count has a length limit: the only size bound is the file, at most 1,000,000 UTF-8 bytes.",
  "type": "object",
  "required": ["version", "supportedDatasets"],
  "properties": {
    "version": { "type": "integer", "const": 1, "maximum": 9007199254740991 },
    "supportedDatasets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "datasetId",
          "name",
          "fieldsToAnnotate",
          "annotatableSettings",
          "closedFields"
        ],
        "properties": {
          "datasetId": { "type": "string", "minLength": 1, "pattern": "^[^\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff](?:[\\s\\S]*[^\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff])?$(?![\\s\\S])" },
          "name": { "type": "string", "minLength": 1, "pattern": "^[^\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff](?:[\\s\\S]*[^\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff])?$(?![\\s\\S])" },
          "fieldsToAnnotate": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1, "description": "Exact observation field key. A colon-free key must not use the reserved lowercase fk~...%3A encoding shape.", "pattern": "^(?!fk~[^:]*%3[Aa][^:]*$(?![\\s\\S]))[^\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff](?:[\\s\\S]*[^\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff])?$(?![\\s\\S])" },
            "uniqueItems": true
          },
          "annotatableSettings": {
            "type": "object",
            "propertyNames": { "minLength": 1, "description": "Exact observation field key. A colon-free key must not use the reserved lowercase fk~...%3A encoding shape.", "pattern": "^(?!fk~[^:]*%3[Aa][^:]*$(?![\\s\\S]))[^\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff](?:[\\s\\S]*[^\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff])?$(?![\\s\\S])" },
            "additionalProperties": {
              "type": "object",
              "required": ["minAnnotators", "threshold"],
              "properties": {
                "minAnnotators": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "threshold": {
                  "type": "number",
                  "minimum": -1,
                  "maximum": 1
                }
              },
              "additionalProperties": false
            }
          },
          "closedFields": {
            "type": "array",
            "items": { "type": "string", "minLength": 1, "description": "Exact observation field key. A colon-free key must not use the reserved lowercase fk~...%3A encoding shape.", "pattern": "^(?!fk~[^:]*%3[Aa][^:]*$(?![\\s\\S]))[^\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff](?:[\\s\\S]*[^\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff])?$(?![\\s\\S])" },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
