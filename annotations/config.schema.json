{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cellucid.com/contracts/community-annotation/config-v1.schema.json",
  "title": "Cellucid Community Annotation Repository Configuration",
  "type": "object",
  "required": ["version", "supportedDatasets"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "supportedDatasets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": [
          "datasetId",
          "name",
          "fieldsToAnnotate",
          "annotatableSettings",
          "closedFields"
        ],
        "properties": {
          "datasetId": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^\\S(?:[\\s\\S]*\\S)?$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "^\\S(?:[\\s\\S]*\\S)?$" },
          "fieldsToAnnotate": {
            "type": "array",
            "minItems": 1,
            "maxItems": 200,
            "items": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^\\S(?:[\\s\\S]*\\S)?$" },
            "uniqueItems": true
          },
          "annotatableSettings": {
            "type": "object",
            "maxProperties": 200,
            "propertyNames": { "minLength": 1, "maxLength": 256, "pattern": "^\\S(?:[\\s\\S]*\\S)?$" },
            "additionalProperties": {
              "type": "object",
              "required": ["minAnnotators", "threshold"],
              "properties": {
                "minAnnotators": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 50
                },
                "threshold": {
                  "type": "number",
                  "minimum": -1,
                  "maximum": 1
                }
              },
              "additionalProperties": false
            }
          },
          "closedFields": {
            "type": "array",
            "maxItems": 200,
            "items": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^\\S(?:[\\s\\S]*\\S)?$" },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
