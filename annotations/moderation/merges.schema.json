{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cellucid.com/contracts/community-annotation/merges-v1.schema.json",
  "title": "Cellucid Community Annotation Moderation Merges",
  "type": "object",
  "required": ["version", "updatedAt", "merges"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "updatedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{3})?Z$", "format": "date-time" },
    "merges": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "type": "object",
        "required": ["bucket", "fromSuggestionId", "intoSuggestionId", "by", "at"],
        "properties": {
          "bucket": { "type": "string", "minLength": 3, "maxLength": 1024, "pattern": "^[^:\\s](?:[^:]*[^:\\s])?:\\S(?:[\\s\\S]*\\S)?$" },
          "fromSuggestionId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^\\S(?:[\\s\\S]*\\S)?$" },
          "intoSuggestionId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^\\S(?:[\\s\\S]*\\S)?$" },
          "by": { "type": "string", "minLength": 6, "maxLength": 64, "pattern": "^ghid_[1-9][0-9]*$" },
          "at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{3})?Z$", "format": "date-time" },
          "note": { "type": ["string", "null"], "minLength": 1, "maxLength": 512, "pattern": "^\\S(?:[\\s\\S]*\\S)?$" },
          "editedAt": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{3})?Z$", "format": "date-time" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
