{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cellucid.com/contracts/community-annotation/user-v1.schema.json",
  "title": "Cellucid Community Annotation User File",
  "type": "object",
  "required": ["version", "username", "githubUserId", "updatedAt", "suggestions", "votes"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "username": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^\\S(?:[\\s\\S]*\\S)?$(?![\\s\\S])" },
    "githubUserId": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "login": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^\\S(?:[\\s\\S]*\\S)?$(?![\\s\\S])" },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "^\\S(?:[\\s\\S]*\\S)?$(?![\\s\\S])" },
    "title": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "^\\S(?:[\\s\\S]*\\S)?$(?![\\s\\S])" },
    "orcid": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{4}-[0-9]{4}-[0-9]{3}[0-9X]$(?![\\s\\S])" },
    "linkedin": { "type": "string", "pattern": "^[a-z0-9-]{3,120}$(?![\\s\\S])" },
    "updatedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{3})?Z$(?![\\s\\S])", "format": "date-time" },
    "datasets": {
      "type": "object",
      "maxProperties": 200,
      "description": "Informational per-user dataset access metadata (does not affect voting).",
      "propertyNames": { "minLength": 1, "maxLength": 256, "pattern": "^\\S(?:[\\s\\S]*\\S)?$(?![\\s\\S])" },
      "additionalProperties": {
        "type": "object",
        "required": ["fieldsToAnnotate", "lastAccessedAt"],
        "properties": {
          "fieldsToAnnotate": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "description": "Exact observation field key. A colon-free key must not use the reserved lowercase fk~...%3A encoding shape.",
              "pattern": "^(?!fk~[^:]*%3[Aa][^:]*$(?![\\s\\S]))\\S(?:[\\s\\S]*\\S)?$(?![\\s\\S])"
            },
            "uniqueItems": true
          },
          "lastAccessedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{3})?Z$(?![\\s\\S])", "format": "date-time" }
        },
        "additionalProperties": false
      }
    },
    "suggestions": {
      "type": "object",
      "maxProperties": 5000,
      "description": "Map of bucket keys (<fieldKey>:<categoryLabel>) to suggestion arrays. If fieldKey contains ':', Cellucid encodes it as 'fk~<urlencoded>' (example: fk~celltype%3Acoarse:...).",
      "propertyNames": { "minLength": 3, "maxLength": 1024, "pattern": "^[^:\\s](?:[^:]*[^:\\s])?:\\S(?:[\\s\\S]*\\S)?$(?![\\s\\S])" },
      "additionalProperties": {
        "type": "array",
        "maxItems": 200,
        "items": {
          "type": "object",
          "required": ["id", "label", "proposedBy", "proposedAt"],
          "properties": {
            "id": { "type": "string", "minLength": 1, "maxLength": 128, "description": "Suggestion id; ':' is reserved as the bucket/id delimiter.", "pattern": "^[^:\\s](?:[^:]*[^:\\s])?$(?![\\s\\S])" },
            "label": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "^\\S(?:[\\s\\S]*\\S)?$(?![\\s\\S])" },
            "ontologyId": { "type": ["string", "null"], "minLength": 1, "maxLength": 64, "pattern": "^\\S(?:[\\s\\S]*\\S)?$(?![\\s\\S])" },
            "evidence": { "type": ["string", "null"], "minLength": 1, "maxLength": 2000, "pattern": "^\\S(?:[\\s\\S]*\\S)?$(?![\\s\\S])" },
            "markers": {
              "type": ["array", "null"],
              "maxItems": 50,
              "items": {
                "oneOf": [
                  { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^\\S(?:[\\s\\S]*\\S)?$(?![\\s\\S])" },
                  {
                    "type": "object",
                    "required": ["gene"],
                    "properties": {
                      "gene": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^\\S(?:[\\s\\S]*\\S)?$(?![\\s\\S])" },
                      "logFC": { "type": "number" },
                      "pval": { "type": "number" }
                    },
                    "additionalProperties": false
                  }
                ]
              }
            },
            "proposedBy": { "type": "string", "minLength": 6, "maxLength": 64, "pattern": "^ghid_[1-9][0-9]*$(?![\\s\\S])" },
            "proposedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{3})?Z$(?![\\s\\S])", "format": "date-time" },
            "editedAt": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{3})?Z$(?![\\s\\S])", "format": "date-time" }
          },
          "additionalProperties": false
        }
      }
    },
    "votes": {
      "type": "object",
      "maxProperties": 50000,
      "description": "Map of suggestion ids to vote direction.",
      "propertyNames": { "minLength": 1, "maxLength": 128, "description": "Suggestion id; ':' is reserved as the bucket/id delimiter.", "pattern": "^[^:\\s](?:[^:]*[^:\\s])?$(?![\\s\\S])" },
      "additionalProperties": {
        "type": "string",
        "enum": ["up", "down"]
      }
    },
    "comments": {
      "type": "object",
      "maxProperties": 10000,
      "description": "Map of suggestion ids to user's comments on that suggestion.",
      "propertyNames": { "minLength": 1, "maxLength": 128, "description": "Suggestion id; ':' is reserved as the bucket/id delimiter.", "pattern": "^[^:\\s](?:[^:]*[^:\\s])?$(?![\\s\\S])" },
      "additionalProperties": {
        "type": "array",
        "maxItems": 800,
        "items": {
          "type": "object",
          "required": ["id", "text", "authorUsername", "createdAt"],
          "properties": {
            "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^\\S(?:[\\s\\S]*\\S)?$(?![\\s\\S])" },
            "text": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "^\\S(?:[\\s\\S]*\\S)?$(?![\\s\\S])" },
            "authorUsername": { "type": "string", "minLength": 6, "maxLength": 64, "pattern": "^ghid_[1-9][0-9]*$(?![\\s\\S])" },
            "createdAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{3})?Z$(?![\\s\\S])", "format": "date-time" },
            "editedAt": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{3})?Z$(?![\\s\\S])", "format": "date-time" }
          },
          "additionalProperties": false
        }
      }
    },
    "deletedSuggestions": {
      "type": "object",
      "maxProperties": 10000,
      "description": "Map of bucket keys (<fieldKey>:<categoryLabel>) to suggestion ids deleted by the proposer. If fieldKey contains ':', Cellucid encodes it as 'fk~<urlencoded>' (example: fk~celltype%3Acoarse:...).",
      "propertyNames": { "minLength": 3, "maxLength": 1024, "pattern": "^[^:\\s](?:[^:]*[^:\\s])?:\\S(?:[\\s\\S]*\\S)?$(?![\\s\\S])" },
      "additionalProperties": {
        "type": "array",
        "maxItems": 5000,
        "items": { "type": "string", "minLength": 1, "maxLength": 128, "description": "Suggestion id; ':' is reserved as the bucket/id delimiter.", "pattern": "^[^:\\s](?:[^:]*[^:\\s])?$(?![\\s\\S])" },
        "uniqueItems": true
      }
    }
  },
  "additionalProperties": false
}
